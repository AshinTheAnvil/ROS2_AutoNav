<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Gazebo extension file -->
  <xacro:include filename="$(find myrobot_description)/urdf/my_robot.gazebo" />

  <!-- Base footprint -->
  <link name="robot_footprint" />

  <joint name="robot_footprint_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="robot_footprint"/>
    <child link="chassis"/>
  </joint>

  <!-- === CHASSIS === -->
  <link name="chassis">
    <inertial>
      <mass value="15.0"/>
      <origin xyz="0.0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.15" ixy="0" ixz="0" iyy="0.15" iyz="0" izz="0.2"/>
    </inertial>

    <collision name="collision">
      <origin xyz="0 0 0" rpy="0 0 0"/> 
      <geometry>
        <cylinder radius="0.17" length="0.12"/>
      </geometry>
    </collision>

    <visual name="chassis_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.17" length="0.12"/>
      </geometry>
    </visual>

    <!-- Casters -->
    <collision name="back_caster_collision">
      <origin xyz="-0.12 0 -0.05" rpy="0 0 0"/>
      <geometry><sphere radius="0.0499"/></geometry>
    </collision>
    <visual name="back_caster_visual">
      <origin xyz="-0.12 0 -0.05" rpy="0 0 0"/>
      <geometry><sphere radius="0.05"/></geometry>
    </visual>

    <collision name="front_caster_collision">
      <origin xyz="0.12 0 -0.05" rpy="0 0 0"/>
      <geometry><sphere radius="0.0499"/></geometry>
    </collision>
    <visual name="front_caster_visual">
      <origin xyz="0.12 0 -0.05" rpy="0 0 0"/>
      <geometry><sphere radius="0.05"/></geometry>
    </visual>
  </link>

  <!-- === CAMERA === -->
  <link name="camera">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <collision>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
    </collision>
    <visual>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="camera_color">
        <color rgba="0.2 0.8 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.2 0 0" rpy="0 0 0"/>
    <parent link="chassis"/>
    <child link="camera"/>
  </joint>

  <!-- === HOKUYO LIDAR === -->
  <link name="hokuyo">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <collision>
      <geometry><box size="0.1 0.1 0.1"/></geometry>
    </collision>
    <visual>
      <geometry>
        <mesh filename="package://myrobot_description/meshes/hokuyo.dae"/>
      </geometry>
      <material name="hokuyo_color">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="hokuyo_joint" type="fixed">
    <origin xyz="0.15 0 0.1" rpy="0 0 0"/>
    <parent link="chassis"/>
    <child link="hokuyo"/>
  </joint>

  <!-- === WHEELS === -->
  <link name="left_wheel">
    <inertial>
      <mass value="5"/>
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="0 0.15 0" rpy="0 0 0"/>
    <parent link="chassis"/>
    <child link="left_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <inertial>
      <mass value="5"/>
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
      <geometry><cylinder radius="0.1" length="0.05"/></geometry>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="0 -0.15 0" rpy="0 0 0"/>
    <parent link="chassis"/>
    <child link="right_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>

